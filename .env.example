# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Goldsky webhook security (shared secret for HMAC-SHA256 validation)
GOLDSKY_WEBHOOK_SECRET=your_goldsky_webhook_secret_here

# MySQL (evidence storage)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=gibbor

# Twilio SMS (for production emergency alerts)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
# Comma-separated list of emergency contact numbers
EMERGENCY_CONTACT_NUMBERS=+1234567890,+0987654321
